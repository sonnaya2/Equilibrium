*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.dev-*.log
.codex-*.log

# ---------------------------------------------------------------------------
# Local / generated data specifics
# ---------------------------------------------------------------------------
# data/canonical/ is generated but tracked on purpose - it is the reviewable
# form of the dataset, and .gitattributes pins it to LF so parity holds.
data/**/*.raw.json
data/**/.cache/
/public/data/v*/
/docs/data-catalog.md

# Upstream downloads staged before import into public/game/. Never a build input.
# (also covered by /.asset-cache/ above)

# ---------------------------------------------------------------------------
# Playwright / E2E artifacts (configs in repo root stay tracked)
# ---------------------------------------------------------------------------
/playwright/.cache/
.playwright-mcp/
playwright/.auth/
**/trace.zip

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Vercel CLI (deploy metadata / project link)
.vercel

# Yarn PnP (defensive; this repo uses npm)
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Scratch output of the dev-only region authoring scripts
scripts/.region-draft.json
scripts/.region-areas.json
scripts/.map-terrain-debug.png
scripts/.map-anchor-audit/
scripts/.*.png
scripts/.*.jpg
scripts/.*.webp

# ---------------------------------------------------------------------------
# Temporary files
# ---------------------------------------------------------------------------
/tmp-*/
/tmp_*/
tmp-*
tmp_*
*.new
*.bak
*.orig
.tools-scratch/

# Root QA screenshots (not product art)
/audit-data-*.png
/data-broken-check.png
/data-fixed-layout.png
/data-icons-audit.png
/map-fix-*.png
/map-overview-*.png
/clipboard-*.png

# One-shot tools (product scripts live under scripts/ without leading _)
tools/_*
tools/__pycache__/
scripts/_*.mjs
scripts/_*.txt
scripts/_*.ps1
scripts/_*.cmd
scripts/_*.py

# ---------------------------------------------------------------------------
# Local research and asset-provenance scratch; never a build input.
