# Dependencies
node_modules/

# ---------------------------------------------------------------------------
# Build, test, cache, and audit output
# ---------------------------------------------------------------------------
# NOTE: build/ out/ and data/ are anchored with a leading slash on purpose.
# app/build/ and app/data/ are App Router routes - an unanchored pattern
# would silently untrack them.
/.next/
/out/
/dist/
/build/
/coverage/
/reports/*
!/reports/*.md
/playwright-report/
/test-results/
/blob-report/
/.shots/
/design-previews/
/exports/
/logs/
/scratch/
/.wiki-cache/
/.asset-cache/
/.generated/
/.cache/
*.tsbuildinfo
next-env.d.ts
.turbo/
.eslintcache

# ---------------------------------------------------------------------------
# Secrets / env - never commit real credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.env*.local
.env.vercel
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*credentials*
*service-account*.json
.npmrc
!.npmrc.example
.netrc
certificates/

# ---------------------------------------------------------------------------
# AI assistants and local agent tooling
# ---------------------------------------------------------------------------
