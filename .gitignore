# Dependencies / build
node_modules/
.next/
/out/
/dist/
/build/
*.tsbuildinfo
next-env.d.ts
coverage/
.turbo/
.cache/
.eslintcache

# NOTE: build/ out/ and data/ are anchored with a leading slash on purpose.
# app/build/ and app/data/ are App Router routes - an unanchored pattern
# would silently untrack them.

# ---------------------------------------------------------------------------
# Secrets / env - never commit real credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.env*.local
.env.vercel
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*credentials*
*service-account*.json
.npmrc
!.npmrc.example
.netrc
certificates/

# IDE / personal agent state
.vscode/
.idea/
.cursor/
.cursor
.agents/
.grok/
.kimi-code/
.codex/
*.kate-swp
.mcp.json

# Claude project configuration is tracked.
# Only machine-specific state and mutable local work stay untracked.
CLAUDE.local.md
TASKS.local.md
.claude/settings.local.json
.claude/memory/
.claude/transcripts/
.claude/sessions/
.claude/worktrees/

# Agent install scaffolding - not project documentation
README-FIRST.md
CHANGES.md

