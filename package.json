{
  "name": "rs3-equilibrium",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN NOTICE",
  "homepage": "https://github.com/sonnaya2/Equilibrium",
  "bugs": {
    "url": "https://github.com/sonnaya2/Equilibrium/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sonnaya2/Equilibrium.git"
  },
  "scripts": {
    "data:audit": "node scripts/data/audit.mjs",
    "data:rebuild": "node scripts/data/platform.mjs rebuild",
    "data:migrate": "node scripts/data/platform.mjs migrate",
    "data:import": "node scripts/data/platform.mjs import",
    "data:apply": "node scripts/data/platform.mjs apply",
    "data:validate": "node scripts/data/platform.mjs validate",
    "data:validate:changed": "node scripts/data/platform.mjs validate --changed",
    "data:export": "node scripts/data/platform.mjs export",
    "data:canonical:export": "node scripts/data/platform.mjs canonical-export",
    "data:canonical:validate": "node scripts/data/platform.mjs canonical-validate",
    "data:export:changed": "node scripts/data/platform.mjs export --changed",
    "data:find": "node scripts/data/platform.mjs find",
    "data:show": "node scripts/data/platform.mjs show",
    "data:context": "node scripts/data/platform.mjs context",
    "data:related": "node scripts/data/platform.mjs related",
    "data:sources": "node scripts/data/platform.mjs sources",
    "data:impact": "node scripts/data/platform.mjs impact",
    "data:query": "node scripts/data/platform.mjs query",
    "data:diff": "node scripts/data/platform.mjs diff",
    "data:stats": "node scripts/data/platform.mjs stats",
    "data:doctor": "node scripts/data/platform.mjs doctor",
    "data:transforms": "node scripts/data/platform.mjs transforms",
    "data:benchmark": "node scripts/data/platform.mjs benchmark",
    "audit:data": "npm run data:rebuild && node scripts/data/audit.mjs && npm run data:doctor",
    "art:inventory": "node scripts/assets/inventory.mjs",
    "art:index": "node scripts/assets/build-icon-index.mjs",
    "art:index:check": "node scripts/assets/build-icon-index.mjs --check",
    "art:aliases": "node scripts/assets/check-aliases.mjs",
    "art:check": "node scripts/assets/check.mjs",
    "predev": "npm run data:rebuild",
    "dev": "next dev",
    "prebuild": "npm run build:data",
    "build": "next build",
    "build:data": "npm run data:rebuild",
    "start": "next start",
    "pretypecheck": "npm run data:rebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check --end-of-line auto \"app/**/*.{ts,tsx,css,mjs}\" \"src/**/*.{ts,tsx,css}\" \"eslint.config.mjs\" \"vitest.config.ts\" \"next.config.ts\" \"playwright.config.ts\"",
    "pretest": "npm run data:rebuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "art:fetch": "node scripts/assets/fetch-sources.mjs",
    "art:import": "node scripts/assets/import-sources.mjs",
    "build:map": "npm run data:rebuild && node --max-old-space-size=6144 scripts/build-map-terrain.mjs && node scripts/build-poi-atlas.mjs",
    "audit:map:anchors": "node scripts/audit-map-anchors.mjs",
    "optimize:images": "node scripts/optimize-game-images.mjs",
    "optimize:map": "node scripts/optimize-map-images.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "next": "^16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
