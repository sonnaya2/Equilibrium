    "dev": "next dev",
    "prebuild": "npm run build:data",
    "build": "next build",
    "build:data": "npm run data:rebuild && node scripts/build-research-store.mjs --check",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check --end-of-line auto \"app/**/*.{ts,tsx,css,mjs}\" \"src/**/*.{ts,tsx,css}\" \"eslint.config.mjs\" \"vitest.config.ts\" \"next.config.ts\" \"playwright.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync:combat": "node scripts/sync-combat-data.ts",
    "sync:league:disabled": "node scripts/sync-league-data.ts",
    "sync:assets": "node scripts/sync-assets.mjs && node scripts/publish-assets.mjs",
    "sync:quests": "node scripts/sync-quest-regions.mjs",
    "sync:quests:auto": "node scripts/sync-equilibrium-auto-quests.mjs",
    "sync:planner": "node scripts/sync-planner-expansions.mjs && node scripts/sync-planner-supplements.mjs",
    "sync:planner:supplements": "node scripts/sync-planner-supplements.mjs",
    "build:map": "node --max-old-space-size=6144 scripts/build-map-terrain.mjs && node scripts/build-poi-atlas.mjs",
    "sync:map:coords": "node scripts/sync-map-coordinates.mjs",
    "audit:map:anchors": "node scripts/audit-map-anchors.mjs",
