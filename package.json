{
  "name": "rs3-equilibrium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "normalize:data": "node scripts/normalize-scraped-data.mjs && node scripts/sync-reference-data.mjs && node scripts/sync-planner-expansions.mjs && node scripts/sync-planner-supplements.mjs",
    "audit:progression": "node scripts/audit-progression-unlocks.mjs",
    "audit:enrichment": "node scripts/audit-progression-enrichment.mjs && node scripts/audit-drop-cleaner-enrichment.mjs",
    "audit:dungeoneering2026": "node scripts/audit-dungeoneering-remaster.mjs",
    "audit:aura2026": "node scripts/audit-aura-overhaul.mjs",
    "audit:references": "node scripts/audit-reference-harvest.mjs",
    "audit:masterwork": "node scripts/audit-masterwork-staff-chain.mjs",
    "audit:boundaries": "node scripts/audit-region-boundaries.mjs",
    "audit:supplements": "node scripts/audit-archaeology-collections.mjs && node scripts/audit-archaeology-guild.mjs && node scripts/audit-archaeology-utilities.mjs && node scripts/audit-invention-components.mjs && node scripts/audit-invention-perk-families.mjs && node scripts/audit-invention-perk-materials.mjs && node scripts/audit-invention-wiki-taxonomy.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync:combat": "node scripts/sync-combat-data.ts",
    "sync:league": "node scripts/sync-league-data.ts",
    "sync:assets": "node scripts/sync-assets.mjs",
    "sync:quests": "node scripts/sync-quest-regions.mjs",
    "sync:quests:auto": "node scripts/sync-equilibrium-auto-quests.mjs",
    "sync:planner": "node scripts/sync-planner-expansions.mjs && node scripts/sync-planner-supplements.mjs",
    "sync:planner:supplements": "node scripts/sync-planner-supplements.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "next": "^16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
