{
  "id": "issue-04-dedupe-intra",
  "title": "Intra-region exact upgrade-name dedupe",
  "date": "2026-07-26",
  "applyReady": true,
  "catalogReadOnly": "data/research/catalog.json",
  "policy": [
    "For each exact double name inside one region.upgrades[], keep one copy (prefer longest detail).",
    "Use dedupeUpgradeName keep=longest-detail for pure same-name doubles.",
    "Additionally remove bare upgrade name \"Moonrise Dig Site\" on havenhythe when \"Moonrise dig-site hub (collections & mysteries)\" already exists (area string stays; content/area are out of scope).",
    "Do not edit catalog.json in this pass — patch only."
  ],
  "scan": {
    "source": "data/research/catalog.json",
    "exactNameDupGroups": 14,
    "extraRowsFromExactDups": 14,
    "allExactPairsIdentical": true,
    "bareMoonriseDigSiteOnHavenhythe": true
  },
  "ops": [
    {
      "op": "dedupeUpgradeName",
      "regionId": "havenhythe",
      "name": "Moonrise dig-site hub (collections & mysteries)",
      "keep": "longest-detail",
      "note": "Identical double hub row after rename pass; keep one."
    },
    {
      "op": "removeUpgrade",
      "regionId": "havenhythe",
      "name": "Moonrise Dig Site",
      "note": "Bare place-name upgrade collides with renamed hub \"Moonrise dig-site hub (collections & mysteries)\". Area/map pin keep the place string; upgrade role is the hub row only."
